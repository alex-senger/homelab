{
  "uid": "homelab-edge",
  "title": "Edge traffic",
  "tags": [
    "homelab"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "schemaVersion": 41,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "app",
        "label": "App",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "VictoriaMetrics"
        },
        "query": {
          "query": "label_values(envoy_cluster_upstream_rq_total{envoy_cluster_name=~\"gateway/.*\"}, envoy_cluster_name)",
          "refId": "app"
        },
        "regex": "/(?<value>gateway\\/[^\\/]+\\/[^_]+_(?<text>.+)_\\d+)/",
        "multi": true,
        "includeAll": true,
        "allValue": "gateway/.*",
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Homelab",
      "type": "dashboards",
      "tags": [
        "homelab"
      ],
      "asDropdown": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests/s",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (app)(label_replace(rate(envoy_cluster_upstream_rq_total{envoy_cluster_name=~\"$app\"}[$__rate_interval]), \"app\", \"$1\", \"envoy_cluster_name\", \"gateway/[^/]+/[^_]+_(.+)_[0-9]+\"))",
          "legendFormat": "{{app}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "fillOpacity": 30
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "5xx ratio",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (app)(label_replace(rate(envoy_cluster_upstream_rq_xx{envoy_cluster_name=~\"$app\",envoy_response_code_class=\"5\"}[$__rate_interval]), \"app\", \"$1\", \"envoy_cluster_name\", \"gateway/[^/]+/[^_]+_(.+)_[0-9]+\")) / sum by (app)(label_replace(rate(envoy_cluster_upstream_rq_xx{envoy_cluster_name=~\"$app\"}[$__rate_interval]), \"app\", \"$1\", \"envoy_cluster_name\", \"gateway/[^/]+/[^_]+_(.+)_[0-9]+\"))",
          "legendFormat": "{{app}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "p95 latency",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (app, le)(label_replace(rate(envoy_cluster_upstream_rq_time_bucket{envoy_cluster_name=~\"$app\"}[$__rate_interval]), \"app\", \"$1\", \"envoy_cluster_name\", \"gateway/[^/]+/[^_]+_(.+)_[0-9]+\")))",
          "legendFormat": "{{app}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "type": "table",
      "title": "Latency (24h)",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (app, le)(label_replace(increase(envoy_cluster_upstream_rq_time_bucket{envoy_cluster_name=~\"$app\"}[24h]), \"app\", \"$1\", \"envoy_cluster_name\", \"gateway/[^/]+/[^_]+_(.+)_[0-9]+\")))",
          "legendFormat": "",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (app, le)(label_replace(increase(envoy_cluster_upstream_rq_time_bucket{envoy_cluster_name=~\"$app\"}[24h]), \"app\", \"$1\", \"envoy_cluster_name\", \"gateway/[^/]+/[^_]+_(.+)_[0-9]+\")))",
          "legendFormat": "",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (app, le)(label_replace(increase(envoy_cluster_upstream_rq_time_bucket{envoy_cluster_name=~\"$app\"}[24h]), \"app\", \"$1\", \"envoy_cluster_name\", \"gateway/[^/]+/[^_]+_(.+)_[0-9]+\")))",
          "legendFormat": "",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "sortBy": [
          {
            "displayName": "p95",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "p50",
              "Value #B": "p95",
              "Value #C": "p99"
            }
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "status-history",
      "title": "Activity per hour (7d)",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 9
      },
      "timeFrom": "7d",
      "interval": "1h",
      "maxDataPoints": 168,
      "targets": [
        {
          "refId": "A",
          "expr": "clamp_max(sum by (app)(label_replace(increase(envoy_cluster_upstream_rq_total{envoy_cluster_name=~\"$app\"}[1h]), \"app\", \"$1\", \"envoy_cluster_name\", \"gateway/[^/]+/[^_]+_(.+)_[0-9]+\")) / on(app) group_left() quantile_over_time(0.95, sum by (app)(label_replace(increase(envoy_cluster_upstream_rq_total{envoy_cluster_name=~\"$app\"}[1h]), \"app\", \"$1\", \"envoy_cluster_name\", \"gateway/[^/]+/[^_]+_(.+)_[0-9]+\"))[7d:1h]), 1)",
          "legendFormat": "{{app}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "continuous-BlPu"
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "showValue": "never"
      },
      "description": "Requests per hour relative to each app's p95 hour (1 = busy)."
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Bandwidth",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (app)(label_replace(rate(envoy_cluster_upstream_cx_rx_bytes_total{envoy_cluster_name=~\"$app\"}[$__rate_interval]), \"app\", \"$1\", \"envoy_cluster_name\", \"gateway/[^/]+/[^_]+_(.+)_[0-9]+\"))",
          "legendFormat": "{{app}} out",
          "instant": false
        },
        {
          "refId": "B",
          "expr": "sum by (app)(label_replace(rate(envoy_cluster_upstream_cx_tx_bytes_total{envoy_cluster_name=~\"$app\"}[$__rate_interval]), \"app\", \"$1\", \"envoy_cluster_name\", \"gateway/[^/]+/[^_]+_(.+)_[0-9]+\"))",
          "legendFormat": "{{app}} in",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/ in$/"
            },
            "properties": [
              {
                "id": "custom.transform",
                "value": "negative-Y"
              }
            ]
          }
        ]
      },
      "options": {}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Client connections by protocol",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "x": 12,
        "y": 25,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(envoy_http_downstream_cx_http1_active{envoy_http_conn_manager_prefix=\"listener-secure\"})",
          "legendFormat": "HTTP/1.1",
          "instant": false
        },
        {
          "refId": "B",
          "expr": "sum(envoy_http_downstream_cx_http2_active{envoy_http_conn_manager_prefix=\"listener-secure\"})",
          "legendFormat": "HTTP/2",
          "instant": false
        },
        {
          "refId": "C",
          "expr": "sum(envoy_http_downstream_cx_http3_active{envoy_http_conn_manager_prefix=\"listener-secure\"})",
          "legendFormat": "HTTP/3",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "fillOpacity": 30
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "type": "table",
      "title": "Internal flows (1h)",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(25, sum by (source_namespace, source_workload, destination_namespace, destination_workload)(increase(hubble_flows_processed_total{verdict=\"FORWARDED\",source_workload!=\"\",destination_workload!=\"\"}[1h])))",
          "legendFormat": "",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "sortBy": [
          {
            "displayName": "flows",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "flows"
            },
            "indexByName": {
              "source_namespace": 0,
              "source_workload": 1,
              "destination_namespace": 2,
              "destination_workload": 3,
              "Value": 4
            }
          }
        }
      ]
    }
  ]
}
