{
  "uid": "homelab-minecraft",
  "title": "Minecraft",
  "tags": [
    "homelab"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "schemaVersion": 41,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "name": "Server start",
        "enable": true,
        "iconColor": "blue",
        "datasource": {
          "type": "prometheus",
          "uid": "VictoriaMetrics"
        },
        "expr": "(time() - kube_pod_start_time{namespace=\"minecraft\",pod=~\"minecraft-.*\"}) < 300",
        "step": "300s",
        "titleFormat": "Server started",
        "textFormat": "{{pod}}"
      }
    ]
  },
  "links": [
    {
      "title": "Homelab",
      "type": "dashboards",
      "tags": [
        "homelab"
      ],
      "asDropdown": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Server",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "TPS",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mc_tps",
          "legendFormat": "",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 20,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 15
              },
              {
                "color": "green",
                "value": 19.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Tick duration",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mc_tick_duration_average / 1e6",
          "legendFormat": "avg",
          "instant": false
        },
        {
          "refId": "B",
          "expr": "mc_tick_duration_max / 1e6",
          "legendFormat": "max",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "JVM heap",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(mc_jvm_memory{type=\"allocated\"}) - sum(mc_jvm_memory{type=\"free\"})",
          "legendFormat": "used",
          "instant": false
        },
        {
          "refId": "B",
          "expr": "sum(mc_jvm_memory{type=\"max\"})",
          "legendFormat": "max",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "max"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {}
    },
    {
      "id": 17,
      "type": "bargauge",
      "title": "World size",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mc_world_size",
          "legendFormat": "{{world}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
