    {
      "id": 8,
      "type": "timeseries",
      "title": "Players online (30d)",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(max by (player)(mc_player_online))",
          "legendFormat": "online",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineInterpolation": "stepAfter",
            "fillOpacity": 40,
            "axisSoftMax": 10
          },
          "decimals": 0,
          "min": 0
        },
        "overrides": []
      },
      "options": {},
      "timeFrom": "30d"
    },
    {
      "id": 9,
      "type": "state-timeline",
      "title": "Who was online (7d)",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (player)(mc_player_online)",
          "legendFormat": "{{player}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "offline",
                  "color": "transparent",
                  "index": 0
                },
                "1": {
                  "text": "online",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true
      },
      "timeFrom": "7d"
    },
