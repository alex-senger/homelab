{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  extends: [
    "config:recommended",
    ":dependencyDashboard",
    "helpers:pinGitHubActionDigests",
  ],

  timezone: "Europe/Berlin",

  // Weekly, not continuous.
  schedule: ["* 0-6 * * 1"],
  prConcurrentLimit: 5,
  commitMessagePrefix: "chore(deps): ",

  hostRules: [
    {
      matchHost: "ghcr.io",
      hostType: "docker",
      username: "alex-senger",
      password: "{{ secrets.GHCR_TOKEN }}",
    },
  ],

  packageRules: [
    {
      // Either of these can take the cluster down: Cilium is the CNI, and
      // ArgoCD is what applies everything else. Always a dedicated PR, never
      // automerged, never batched with anything.
      matchPackageNames: ["cilium", "argo-cd"],
      groupName: null,
      automerge: false,
      addLabels: ["critical-infrastructure"],
      prPriority: 10,
    },
    {
      // Merging only edits talconfig; the upgrade itself is a manual talosctl run.
      matchPackageNames: ["siderolabs/talos", "kubernetes/kubernetes"],
      automerge: false,
      addLabels: ["critical-infrastructure"],
    },
    {
      // Everything else: patch bumps land on their own once CI is green.
      matchUpdateTypes: ["patch"],
      matchPackageNames: ["!cilium", "!argo-cd", "!siderolabs/talos", "!kubernetes/kubernetes"],
      automerge: true,
      automergeType: "pr",
      platformAutomerge: true,
    },
    {
      // Timestamp tags (YYYYMMDD_HHMMSS), not semver.
      matchPackageNames: ["ghcr.io/nextcloud-releases/aio-imaginary"],
      versioning: "regex:^(?<major>\\d{4})(?<minor>\\d{4})_(?<patch>\\d{6})$",
    },
    {
      // CNPG build tags: <pg major>.<minor>-<YYYYMMDDhhmm>-minimal-trixie.
      matchPackageNames: ["ghcr.io/cloudnative-pg/postgresql"],
      versioning: "regex:^(?<major>\\d+)\\.(?<minor>\\d+)-(?<patch>\\d{12})-(?<compatibility>minimal-trixie)$",
    },
    {
      // linuxserver.io tags: <version>-r<pkgrel>-ls<build>.
      matchPackageNames: ["linuxserver/**"],
      versioning: "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-r(?<build>\\d+)-ls(?<revision>\\d+)$",
    },
    {
      matchUpdateTypes: ["major"],
      addLabels: ["major-update"],
      automerge: false,
    },
  ],

  customManagers: [
    {
      // CLI tool versions pinned in workflow env: blocks, each marked with a
      // "# renovate:" comment on the preceding line. The built-in managers
      // cover the Helm charts (kustomize manager reads helmCharts[].version)
      // and the actions themselves, but not these curl-installed binaries.
      customType: "regex",
      description: "CLI tool versions pinned in GitHub workflows",
      managerFilePatterns: ["/^\\.github/workflows/.+\\.ya?ml$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+[A-Z_]+_VERSION:\\s*(?<currentValue>\\S+)",
      ],
    },
    {
      customType: "regex",
      description: "Pinned images in Kubernetes manifests",
      managerFilePatterns: ["/^(apps|infrastructure)/.+\\.ya?ml$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+(?:image|imageName):\\s*[^\\s:]+:(?<currentValue>[^\\s@]+)",
      ],
    },
    {
      // GitHub release assets fetched by URL (e.g. Minecraft PLUGINS). The match spans
      // the whole URL, so every occurrence of the version in it (tag + filename) is bumped.
      customType: "regex",
      description: "GitHub release asset URLs in manifests",
      managerFilePatterns: ["/^(apps|infrastructure)/.+\\.ya?ml$/"],
      matchStrings: [
        "https://github\\.com/(?<depName>[^/\\s]+/[^/\\s]+)/releases/download/v(?<currentValue>[^/\\s]+)/\\S+",
      ],
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^v(?<version>.+)$",
    },
    {
      customType: "regex",
      description: "Talos and Kubernetes versions in talconfig",
      managerFilePatterns: ["/^talos/talconfig\\.yaml$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+[a-z]+Version:\\s*(?<currentValue>\\S+)",
      ],
    },
    {
      // Manifests pulled by versioned raw GitHub URL. URLs sharing a repo fold
      // into a single update, so they move together.
      customType: "regex",
      description: "Versioned manifest URLs in kustomizations",
      managerFilePatterns: ["/^infrastructure/.+/kustomization\\.yaml$/"],
      matchStrings: [
        "https://raw\\.githubusercontent\\.com/(?<depName>[^/\\s]+/[^/\\s]+)/(?<currentValue>v[^/\\s]+)/",
      ],
      datasourceTemplate: "github-releases",
    },
  ],
}
