# Helm chart cache pulled by kustomize --enable-helm
charts/
*.tgz

# OS
.DS_Store

# Local agent/plugin tooling artifacts — not part of the cluster definition
.claude-flow/
.claude/
ruvector.db

# Design specs and implementation plans — kept locally, never published.
# They describe internal network topology, hardware, and operational history
# that does not belong in a public repository.
docs/superpowers/

# talhelper output: PLAINTEXT machine configs containing every CA private key.
# Committing this once on a public repo is an unrecoverable key disclosure.
clusterconfig/

# Unencrypted secrets, if ever generated by mistake
talos/talsecret.yaml
talenv.yaml

# VPS Ansible: secrets only as *.sops.yml; never plaintext.
vps/**/secrets.yml
vps/**/secrets.yaml
vps/inventory.local.ini
vps/group_vars/vps.yml
vps/tests/.out/

.ansible/
