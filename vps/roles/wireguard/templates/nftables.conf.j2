#!/usr/sbin/nft -f
# Managed by Ansible (vps/roles/wireguard). Default-deny inbound, with the
# minimum this box needs to function as the public front door: SSH (so the
# operator isn't locked out), the WireGuard tunnel, and the nginx stream
# relay's public listener.

flush ruleset

table inet filter {
    chain input {
        type filter hook input priority 0; policy drop;

        iif "lo" accept
        ct state invalid drop
        ct state established,related accept

        icmp type { echo-request, destination-unreachable, time-exceeded } accept
        icmpv6 type { echo-request, destination-unreachable, time-exceeded, nd-neighbor-solicit, nd-neighbor-advert } accept

        tcp dport {{ ssh_port }} accept
        udp dport {{ wg_listen_port }} accept
        tcp dport {{ stream_port }} accept
    }

    chain forward {
        type filter hook forward priority 0; policy drop;

        # Route traffic arriving on the WireGuard tunnel onward — the VPS
        # itself has nothing behind wg0 to forward to besides the tunnel
        # peer, but ip_forward + this chain is what lets the box act as a
        # relay rather than only a local nginx listener.
        ct state established,related accept
        iifname "wg0" accept
        oifname "wg0" accept
    }

    chain output {
        type filter hook output priority 0; policy accept;
    }
}
