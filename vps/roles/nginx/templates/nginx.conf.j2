# Managed by Ansible (vps/roles/nginx).
user www-data;
worker_processes auto;
pid /run/nginx.pid;
include /etc/nginx/modules-enabled/*.conf;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    sendfile on;
    server_tokens off;
    client_max_body_size 1k;
    access_log /var/log/nginx/access.log;
    error_log /var/log/nginx/error.log;

    ssl_protocols TLSv1.2 TLSv1.3;

{% for range in firewall_cloudflare_ipv4_ranges + firewall_cloudflare_ipv6_ranges %}
    set_real_ip_from {{ range }};
{% endfor %}
    real_ip_header CF-Connecting-IP;

    # Unknown SNI: no certificate is ever shown.
    server {
        listen 443 ssl default_server;
        listen [::]:443 ssl default_server;
        ssl_reject_handshake on;
    }

    server {
        listen 443 ssl;
        listen [::]:443 ssl;
        server_name {{ nginx_server_name }};

        ssl_certificate {{ nginx_tls_dir }}/origin.pem;
        ssl_certificate_key {{ nginx_tls_dir }}/origin.key;
        # Own CA, not Cloudflare's shared one: only this zone holds the client cert.
        ssl_client_certificate {{ nginx_tls_dir }}/aop-ca.pem;
        ssl_verify_client on;

        if ($request_method !~ ^(GET|HEAD)$) {
            return 405;
        }

        location / {
            proxy_pass http://127.0.0.1:{{ website_port }};
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Proto https;
        }
    }
}
